{
  "name": "harnessorch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test -w packages/engine",
    "typecheck": "npm run typecheck -w packages/engine",
    "lint": "eslint .",
    "build": "npm run build -w packages/engine && npm run build -w apps/desktop",
    "desktop": "npm run build -w packages/engine && npm run dev -w apps/desktop",
    "ho": "npm run ho -w packages/engine --",
    "app": "node scripts/build-app.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
